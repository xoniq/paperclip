{
  "name": "@paperclipai/plugin-telegram-bridge",
  "version": "0.1.0",
  "description": "Chat with a Paperclip agent from Telegram. Each Telegram topic is an issue thread; replies wake the assignee.",
  "license": "MIT",
  "homepage": "https://github.com/paperclipai/paperclip",
  "bugs": {
    "url": "https://github.com/paperclipai/paperclip/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paperclipai/paperclip",
    "directory": "packages/plugins/plugin-telegram-bridge"
  },
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "connector",
    "telegram"
  ],
  "scripts": {
    "prebuild": "node ../../../scripts/ensure-plugin-build-deps.mjs",
    "build": "node ./esbuild.config.mjs",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "node ../../../scripts/ensure-plugin-build-deps.mjs && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "dev": "node ./esbuild.config.mjs --watch"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10",
    "esbuild": "^0.28.1"
  }
}
